{#
  Giftology — Gift finder  (§7)  — faithful port.
  Quiz logic lives in giftology.js; this is the shell. Each answer scores a
  category key and the result button links to that Salla category (or WhatsApp
  for "custom"). Category links come from twilight.json settings via data-*.
#}
{% set gly_wa_number = theme.settings.get('gly_whatsapp') %}
{% set gly_wa_custom = 'https://wa.me/' ~ gly_wa_number ~ '?text=' ~ trans('blocks.gly.wa.custom_msg')|url_encode %}

<section id="gly-finder" class="gly-section gly-quiz">
  <div class="gly-wrap">
    <div class="gly-quiz-box gly-reveal"
         data-newborn="{{ theme.settings.get('gly_cat_newborn') ?: store.url }}"
         data-kids="{{ theme.settings.get('gly_cat_kids') ?: store.url }}"
         data-men="{{ theme.settings.get('gly_cat_men') ?: store.url }}"
         data-occasion="{{ theme.settings.get('gly_cat_occasion') ?: store.url }}"
         data-favors="{{ theme.settings.get('gly_cat_favors') ?: store.url }}"
         data-cards="{{ theme.settings.get('gly_cat_cards') ?: store.url }}"
         data-custom="{{ gly_wa_custom }}">
      <svg class="gly-quiz__mag" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-miterlimit="10"><path d="M21,21L21,21c1.105-1.105,2.895-1.105,4,0l5.172,5.172c0.53,0.53,0.828,1.25,0.828,2v0C31,29.734,29.734,31,28.172,31h0c-0.75,0-1.47-0.298-2-0.828L21,25C19.895,23.895,19.895,22.105,21,21z"/><circle cx="11" cy="11" r="10"/><path d="M11,5c-3.314,0-6,2.686-6,6"/><line x1="18" x2="21" y1="18" y2="21"/></svg>
      <div>
        <span class="gly-eyebrow">{{ trans('blocks.gly.finder.eyebrow') }}</span>
        <h2>{{ trans('blocks.gly.finder.title_pre') }} <em>{{ trans('blocks.gly.finder.title_em') }}</em></h2>
        <p class="gly-qlede">{{ trans('blocks.gly.finder.lede') }}</p>
      </div>
      <div class="gly-qcard"></div>
    </div>
  </div>
</section>
