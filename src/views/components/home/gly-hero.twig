{#
  Giftology — Hero  (§5.3)  — faithful port of the reference.
  Strings: blocks.gly.hero.*  ·  CTAs jump to #gly-cats / #gly-custom.
#}
<section class="gly-section gly-hero">
  <div class="gly-wrap gly-hero__grid">

    {# copy #}
    <div class="gly-reveal">
      <span class="gly-eyebrow">{{ trans('blocks.gly.hero.eyebrow') }}</span>
      <h1>{{ trans('blocks.gly.hero.title_pre') }} <span class="gly-accent">{{ trans('blocks.gly.hero.title_em') }}</span> {{ trans('blocks.gly.hero.title_post') }}</h1>
      <p class="gly-lede">{{ trans('blocks.gly.hero.lede') }}</p>
      <div class="gly-cta-row">
        <a href="#gly-cats" class="gly-btn gly-btn-primary">{{ trans('blocks.gly.hero.cta_shop') }}
          <svg class="gly-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a href="#gly-custom" class="gly-btn gly-btn-ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/></svg>{{ trans('blocks.gly.hero.cta_custom') }}</a>
        {% if theme.settings.get('gly_show_latest', true) %}
        <a href="#gly-latest" class="gly-btn gly-btn-ghost">{{ trans('blocks.gly.hero.cta_latest') }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>
        {% endif %}
      </div>
      <div class="gly-hero-stats">
        <div><b>+12 {{ trans('blocks.gly.hero.stat_k') }}</b><span>{{ trans('blocks.gly.hero.stat_gifts') }}</span></div>
        <div><b>+40</b><span>{{ trans('blocks.gly.hero.stat_occasions') }}</span></div>
        <div><b>4.9★</b><span>{{ trans('blocks.gly.hero.stat_rating') }}</span></div>
        <div><b>2018</b><span>{{ trans('blocks.gly.hero.stat_since') }}</span></div>
      </div>
    </div>

    {# visual #}
    <div class="gly-hero__art gly-reveal" aria-hidden="true">
      <div class="gly-blob teal"></div>
      <div class="gly-hero__pattern"></div>
      <div class="gly-blob peach"></div>

      <img class="gly-bow" src="{{ 'images/white_logo.png'|asset }}" alt="" aria-hidden="true">


      <svg class="gly-sparkle" style="top:30px;inset-inline-start:60px;width:26px" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2.5 9.5L24 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z"/></svg>
      <svg class="gly-sparkle" style="bottom:90px;inset-inline-end:30px;width:18px;animation-delay:1s" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2.5 9.5L24 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z"/></svg>

      <div class="gly-fcard fc1"><div class="gly-fcard__ph" style="background:var(--gly-gold)">🎀</div><div><b>{{ trans('blocks.gly.hero.mini_wrap_t') }}</b><small>{{ trans('blocks.gly.hero.mini_wrap_d') }}</small></div></div>
      <div class="gly-fcard fc2"><div class="gly-fcard__ph" style="background:var(--gly-teal-deep)">🚚</div><div><b>{{ trans('blocks.gly.hero.mini_fast_t') }}</b><small>{{ trans('blocks.gly.hero.mini_fast_d') }}</small></div></div>
      <div class="gly-fcard fc3"><div class="gly-fcard__ph" style="background:#e2715f">💌</div><div><b>{{ trans('blocks.gly.hero.mini_card_t') }}</b><small>{{ trans('blocks.gly.hero.mini_card_d') }}</small></div></div>
    </div>

  </div>
</section>
