{#
  Giftology — Category circles  (§5.4)
  Up to 8 fully-editable, in-slot tiles (gly_tile1..8). Each tile is configured
  from the dashboard: show/hide (gly_tileN_enabled), multilingual name
  (gly_tileN_name), a brand icon (gly_tileN_icon dropdown) OR an uploaded image
  that overrides it (gly_tileN_image), and a target Salla category
  (gly_tileN_link, resolved to its page URL by the gly-cat-url partial).
  Tiles 1–6 are shown by default with sensible name/icon fallbacks; 7–8 are off
  until enabled and wrap into a centered second row under the first six.
  Brand SVG icons are drawn as teal silhouettes via CSS mask (.gly-cat-ico).
#}
{% set gly_icons = {
  'baby':     'images/baby.svg',
  'gift':     'images/gift.svg',
  'cake':     'images/cake.svg',
  'tie':      'images/tie.svg',
  'tag':      'images/tag.svg',
  'envelope': 'images/envelope.svg'
} %}

{# defaults for the 6 curated tiles (used when the merchant leaves name/icon blank) #}
{% set gly_defaults = [
  { icon: 'baby',     name: trans('blocks.gly.cats.newborn')  },
  { icon: 'gift',     name: trans('blocks.gly.cats.occasion') },
  { icon: 'cake',     name: trans('blocks.gly.cats.kids')     },
  { icon: 'tie',      name: trans('blocks.gly.cats.men')      },
  { icon: 'tag',      name: trans('blocks.gly.cats.favors')   },
  { icon: 'envelope', name: trans('blocks.gly.cats.cards')    }
] %}

{% set gly_tiles = [] %}
{% for i in 1..8 %}
  {% set d = i <= 6 ? gly_defaults[i - 1] : null %}
  {% if theme.settings.get('gly_tile' ~ i ~ '_enabled', i <= 6) %}
    {% set name  = theme.settings.get('gly_tile' ~ i ~ '_name') ?: (d ? d.name : '') %}
    {% set link  = theme.settings.get('gly_tile' ~ i ~ '_link') %}
    {% set image = theme.settings.get('gly_tile' ~ i ~ '_image') %}
    {% set ikey  = theme.settings.get('gly_tile' ~ i ~ '_icon') %}
    {% if ikey is iterable %}{% set ikey = ikey.value is defined ? ikey.value : ((ikey|first).value is defined ? (ikey|first).value : ikey|first) %}{% endif %}
    {% set ikey  = gly_icons[ikey] is defined ? ikey : (d ? d.icon : 'gift') %}
    {% if name or link or image %}
      {% set gly_tiles = gly_tiles|merge([{ name: name, link: link, image: image, icon: ikey }]) %}
    {% endif %}
  {% endif %}
{% endfor %}

<section id="gly-cats" class="gly-section gly-cats">
  <div class="gly-wrap">
    <div class="gly-shead gly-reveal">
      <span class="gly-eyebrow">{{ trans('blocks.gly.cats.eyebrow') }}</span>
      <h2>{{ trans('blocks.gly.cats.title_pre') }} <em>{{ trans('blocks.gly.cats.title_em') }}</em></h2>
      <p>{{ trans('blocks.gly.cats.sub') }}</p>
    </div>

    <div class="gly-cat-grid gly-reveal">
      {% for t in gly_tiles %}
        {% set turl %}{% include 'components.home.gly-cat-url' with {value: t.link, fallback: store.url} only %}{% endset %}
        <a class="gly-cat" href="{{ turl }}">
          <span class="gly-cat-ic">
            {% if t.image %}
              <img class="gly-cat-img" src="{{ t.image }}" alt="{{ t.name }}" loading="lazy">
            {% else %}
              <i class="gly-cat-ico" style="--gly-ico:url('{{ gly_icons[t.icon]|asset }}')"></i>
            {% endif %}
          </span>
          <span>{{ t.name }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
