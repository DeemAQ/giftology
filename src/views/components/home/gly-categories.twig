{#
  Giftology — Category circles  (§5.4)
  In-slot, up to 8 tiles: 6 curated defaults + 2 optional extras (7th & 8th).
  Each tile uses a brand icon from images/*.svg, rendered as a teal silhouette
  via CSS mask (.gly-cat-ico) so the mixed source SVGs all read on-brand. Each
  tile links to a real Salla category — the merchant picks the target per tile
  from the dashboard (gly_cat_* category pickers); the gly-cat-url partial
  resolves it to that category's page URL and falls back to the store home until
  one is chosen. With 7–8 tiles the overflow wraps centered below the first 6.
  Custom gifts is intentionally NOT a circle (it has its own section).
#}
{% set gly_icons = {
  'baby':     'images/baby.svg',
  'gift':     'images/gift.svg',
  'cake':     'images/cake.svg',
  'tie':      'images/tie.svg',
  'tag':      'images/tag.svg',
  'envelope': 'images/envelope.svg'
} %}

{% set gly_tiles = [
  { icon: 'baby',     label: trans('blocks.gly.cats.newborn'),  link: theme.settings.get('gly_cat_newborn') },
  { icon: 'gift',     label: trans('blocks.gly.cats.occasion'), link: theme.settings.get('gly_cat_occasion') },
  { icon: 'cake',     label: trans('blocks.gly.cats.kids'),     link: theme.settings.get('gly_cat_kids') },
  { icon: 'tie',      label: trans('blocks.gly.cats.men'),      link: theme.settings.get('gly_cat_men') },
  { icon: 'tag',      label: trans('blocks.gly.cats.favors'),   link: theme.settings.get('gly_cat_favors') },
  { icon: 'envelope', label: trans('blocks.gly.cats.cards'),    link: theme.settings.get('gly_cat_cards') }
] %}

{# optional 7th & 8th tiles — appear only when the merchant fills a label or target #}
{% for n in [7, 8] %}
  {% set elabel = theme.settings.get('gly_cat' ~ n ~ '_label') %}
  {% set elink  = theme.settings.get('gly_cat' ~ n ~ '_link') %}
  {% if elabel or elink %}
    {% set eicon = theme.settings.get('gly_cat' ~ n ~ '_icon') %}
    {% if eicon is iterable %}{% set eicon = eicon.value is defined ? eicon.value : ((eicon|first).value is defined ? (eicon|first).value : eicon|first) %}{% endif %}
    {% set gly_tiles = gly_tiles|merge([{ icon: (gly_icons[eicon] is defined ? eicon : 'gift'), label: elabel, link: elink }]) %}
  {% endif %}
{% endfor %}

<section id="gly-cats" class="gly-section gly-cats">
  <div class="gly-wrap">
    <div class="gly-shead gly-reveal">
      <span class="gly-eyebrow">{{ trans('blocks.gly.cats.eyebrow') }}</span>
      <h2>{{ trans('blocks.gly.cats.title_pre') }} <em>{{ trans('blocks.gly.cats.title_em') }}</em></h2>
      <p>{{ trans('blocks.gly.cats.sub') }}</p>
    </div>

    <div class="gly-cat-grid gly-reveal">
      {% for t in gly_tiles %}
        {% set turl %}{% include 'components.home.gly-cat-url' with {value: t.link, fallback: store.url} only %}{% endset %}
        <a class="gly-cat" href="{{ turl }}">
          <span class="gly-cat-ic"><i class="gly-cat-ico" style="--gly-ico:url('{{ gly_icons[t.icon]|asset }}')"></i></span>
          <span>{{ t.label }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
