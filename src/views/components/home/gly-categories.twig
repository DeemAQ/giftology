{#
  Giftology — Category circles  (§5.4)  — faithful port.
  Icons + labels are part of the design; each tile's URL is merchant-
  configurable via twilight.json settings (gly_cat_*). Custom gifts is
  intentionally NOT a circle (it has its own section).
#}
<section id="gly-cats" class="gly-section gly-cats">
  <div class="gly-wrap">
    <div class="gly-shead gly-reveal">
      <span class="gly-eyebrow">{{ trans('blocks.gly.cats.eyebrow') }}</span>
      <h2>{{ trans('blocks.gly.cats.title_pre') }} <em>{{ trans('blocks.gly.cats.title_em') }}</em></h2>
      <p>{{ trans('blocks.gly.cats.sub') }}</p>
    </div>

    <div class="gly-cat-grid gly-reveal">
      <a class="gly-cat" href="{{ theme.settings.get('gly_cat_newborn') ?: store.url }}">
        <div class="gly-cat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M5 21c0-4 3-6.5 7-6.5s7 2.5 7 6.5M10 8h.01M14 8h.01M10.5 10.5c1 .8 2 .8 3 0"/></svg></div>
        <span>{{ trans('blocks.gly.cats.newborn') }}</span>
      </a>
      <a class="gly-cat" href="{{ theme.settings.get('gly_cat_occasion') ?: store.url }}">
        <div class="gly-cat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16v11H4zM4 9l2-5h12l2 5M12 4v16"/></svg></div>
        <span>{{ trans('blocks.gly.cats.occasion') }}</span>
      </a>
      <a class="gly-cat" href="{{ theme.settings.get('gly_cat_kids') ?: store.url }}">
        <div class="gly-cat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11h14v9H5zM3 20h18M7 11V8M12 11V8M17 11V8M7 6c0-1 .8-1.6 0-3M12 6c0-1 .8-1.6 0-3M17 6c0-1 .8-1.6 0-3"/></svg></div>
        <span>{{ trans('blocks.gly.cats.kids') }}</span>
      </a>
      <a class="gly-cat" href="{{ theme.settings.get('gly_cat_men') ?: store.url }}">
        <div class="gly-cat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l-1.5 3 2 11L12 20l-3.5-3 2-11L9 3Z"/></svg></div>
        <span>{{ trans('blocks.gly.cats.men') }}</span>
      </a>
      <a class="gly-cat" href="{{ theme.settings.get('gly_cat_favors') ?: store.url }}">
        <div class="gly-cat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13l-8 8-9-9V4h8l9 9ZM7.5 7.5h.01M13 4c1.5-1 3 .5 2 2M13 4c-1.5-1-3 .5-2 2"/></svg></div>
        <span>{{ trans('blocks.gly.cats.favors') }}</span>
      </a>
      <a class="gly-cat" href="{{ theme.settings.get('gly_cat_cards') ?: store.url }}">
        <div class="gly-cat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18v12H3zM3 7l9 6 9-6"/></svg></div>
        <span>{{ trans('blocks.gly.cats.cards') }}</span>
      </a>
    </div>
  </div>
</section>
