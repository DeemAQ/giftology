{#
  Giftology — category-link resolver (include partial; outputs a URL string).

  Usage:
    {% include 'components.home.gly-cat-url' with {value: <setting>, fallback: store.url, lang: language.code} only %}

  1) Resolves `value` to a URL:
       • plain URL string        → as-is
       • category object / list   → .url / first.url
       • anything else / empty    → fallback (usually store.url)
  2) Rewrites the language segment of the URL (e.g. .../ar/...) to `lang`
     (the visitor's current storefront language), so ONE pasted URL works in
     every language. Only swaps when the path looks like domain/{2-letter}/...
     so normal slugs are left untouched.
#}
{%- set _u = '' -%}
{%- if value.url is defined -%}{%- set _u = value.url -%}
{%- elseif value is iterable and (value|first).url is defined -%}{%- set _u = (value|first).url -%}
{%- elseif value is not iterable and value and (value starts with 'http' or value starts with '/') -%}{%- set _u = value -%}
{%- else -%}{%- set _u = fallback -%}
{%- endif -%}
{%- set _p = _u|split('/') -%}
{%- if lang and _p|length > 4 and _p[3]|length == 2 -%}
{{- (_p|slice(0, 3)|join('/')) ~ '/' ~ lang ~ '/' ~ (_p|slice(4)|join('/')) -}}
{%- else -%}
{{- _u -}}
{%- endif -%}
