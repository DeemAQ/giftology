{#
  Giftology — Customer reviews  (§5.8)
  Now AUTOMATIC: renders Salla's real store testimonials via <salla-reviews
  type="store">. The merchant manages these in the Salla dashboard
  (Settings → Store testimonials / آراء العملاء); they are NOT hardcoded.
  Brand heading + section styling via .gly-testi; the cards inherit brand
  colours from the Raed --color-* variables.
#}
<section id="gly-testi" class="gly-section gly-testi">
  <div class="gly-wrap">
    <div class="gly-shead gly-reveal">
      <span class="gly-eyebrow">{{ trans('blocks.gly.testi.eyebrow') }}</span>
      <h2>{{ trans('blocks.gly.testi.title_pre') }} <em>{{ trans('blocks.gly.testi.title_em') }}</em></h2>
    </div>
    <salla-reviews type="store" limit="9" class="gly-reviews gly-reveal"></salla-reviews>
  </div>
</section>
