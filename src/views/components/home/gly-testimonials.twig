{#
  Giftology — Customer reviews  (§5.8)
  Designed, always-visible review cards (text from locale blocks.gly.testi.*,
  editable per language). Slider/auto-play in giftology.js.
  NOTE: to instead show REAL/automatic store testimonials managed in the Salla
  dashboard, swap the slider below for: <salla-reviews type="store" limit="9">.
#}
{% set gly_reviews = [
  { t: trans('blocks.gly.testi.r1_t'), w: trans('blocks.gly.testi.r1_w'), l: trans('blocks.gly.testi.r1_l') },
  { t: trans('blocks.gly.testi.r2_t'), w: trans('blocks.gly.testi.r2_w'), l: trans('blocks.gly.testi.r2_l') },
  { t: trans('blocks.gly.testi.r3_t'), w: trans('blocks.gly.testi.r3_w'), l: trans('blocks.gly.testi.r3_l') },
  { t: trans('blocks.gly.testi.r4_t'), w: trans('blocks.gly.testi.r4_w'), l: trans('blocks.gly.testi.r4_l') }
] %}

<section id="gly-testi" class="gly-section gly-testi">
  <div class="gly-wrap">
    <div class="gly-shead gly-reveal">
      <span class="gly-eyebrow">{{ trans('blocks.gly.testi.eyebrow') }}</span>
      <h2>{{ trans('blocks.gly.testi.title_pre') }} <em>{{ trans('blocks.gly.testi.title_em') }}</em></h2>
    </div>
    <div class="gly-tslider gly-reveal">
      <div class="gly-ttrack">
        {% for r in gly_reviews %}
          <div class="gly-tcard">
            <div class="stars">★★★★★</div>
            <q>«{{ r.t }}»</q>
            <div class="who">{{ r.w }}<small>{{ r.l }}</small></div>
          </div>
        {% endfor %}
      </div>
      <div class="gly-tdots"></div>
    </div>
  </div>
</section>
