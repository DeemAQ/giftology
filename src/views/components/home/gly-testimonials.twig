{#
  Giftology — Customer reviews  (§5.8)  — AUTOMATIC.
  Renders real store reviews/testimonials via <salla-reviews type="store">.
  Manage them in the Salla dashboard (Store testimonials / آراء العملاء);
  they are NOT hardcoded. Empty until the merchant adds some there.
  Brand heading via .gly-testi; cards inherit brand colours from --color-*.
#}
<section id="gly-testi" class="gly-section gly-testi">
  <div class="gly-wrap">
    <div class="gly-shead gly-reveal">
      <span class="gly-eyebrow">{{ trans('blocks.gly.testi.eyebrow') }}</span>
      <h2>{{ trans('blocks.gly.testi.title_pre') }} <em>{{ trans('blocks.gly.testi.title_em') }}</em></h2>
    </div>
    <salla-reviews type="store" limit="9" class="gly-reviews gly-reveal"></salla-reviews>
  </div>
</section>
