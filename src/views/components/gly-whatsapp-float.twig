{#
  Giftology — Floating "تواصل معنا" WhatsApp button  (§5.10 / §8)
  Global, fixed on all pages. Number + general message from twilight.json settings.
  Styles: .gly-wa in _giftology.scss.
#}
{% set gly_wa_number = theme.settings.get('gly_whatsapp') %}
{% if gly_wa_number %}
  {% set gly_wa_general = 'https://wa.me/' ~ gly_wa_number ~ '?text=' ~ trans('blocks.gly.wa.general_msg')|url_encode %}
  <a class="gly-wa" href="{{ gly_wa_general }}" target="_blank" rel="noopener" aria-label="{{ trans('blocks.gly.wa.float_aria') }}">
    <span class="gly-ring" aria-hidden="true"></span>
    <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.7.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-4.8.9.9-4.7-.3-.4c-1-1.6-1.5-3.4-1.5-5.3C5 9.5 9.9 4.7 16 4.7S27 9.5 27 15.6 22.1 24.8 16 24.8zm6.1-7.3c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.2-.7.1-1.8-.9-3-1.6-4.2-3.6-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5-.1-.2-.8-1.8-1-2.5-.3-.7-.5-.6-.8-.6h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.2 3.4 5.3 4.7 2 .8 2.7.9 3.7.8.6-.1 2-.8 2.3-1.6.3-.8.3-1.4.2-1.6-.1-.1-.3-.2-.6-.3z"/></svg>
    <span class="gly-label">{{ trans('blocks.gly.wa.float_label') }}</span>
  </a>
{% endif %}
