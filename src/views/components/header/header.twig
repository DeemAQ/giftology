{#
  Giftology — Header / nav  (§5.2)  — ported from the reference design.
  Logo + cart + account come from Salla (store.logo, <salla-cart-summary>,
  <salla-user-menu>). The nav (desktop bar + bespoke mobile drawer) lists the
  homepage sections and is built from the section visibility toggles, so it
  grows/shrinks automatically as the merchant enables/disables sections.
  Search opens Salla's global <salla-search> modal.
  Solid-on-scroll + mobile drawer toggle in giftology.js.

  | Variable         | Type    | Description                   |
  | cart.items_count | int     |                               |
  | cart.total       | string  | Formatted total               |
#}
{% set gly_home = store.url %}
{% set gly_nav = [] %}
{% if theme.settings.get('gly_show_categories', true) %}{% set gly_nav = gly_nav|merge([{ url: gly_home ~ '/#gly-cats',   title: trans('blocks.gly.nav.sections') }]) %}{% endif %}
{% if theme.settings.get('gly_show_custom', true) %}{% set gly_nav = gly_nav|merge([{ url: gly_home ~ '/#gly-custom', title: trans('blocks.gly.nav.custom') }]) %}{% endif %}
{% if theme.settings.get('gly_show_finder', true) %}{% set gly_nav = gly_nav|merge([{ url: gly_home ~ '/#gly-finder', title: trans('blocks.gly.nav.finder') }]) %}{% endif %}
{% if theme.settings.get('gly_show_how', true) %}{% set gly_nav = gly_nav|merge([{ url: gly_home ~ '/#gly-how',    title: trans('blocks.gly.nav.how') }]) %}{% endif %}
{% if theme.settings.get('gly_show_testimonials', true) %}{% set gly_nav = gly_nav|merge([{ url: gly_home ~ '/#gly-testi',  title: trans('blocks.gly.nav.testimonials') }]) %}{% endif %}

<header id="gly-hdr" class="gly-header store-header{{ is_page('index') ? '' : ' gly-header--inner' }}">
  <div class="gly-nav-bg"></div>
  <nav class="gly-nav gly-wrap">

    {# logo + sections grouped on the inline-start (right in RTL) #}
    <div class="gly-nav-start">
      {# logo — Salla store data #}
      <a href="{{ store.url }}" class="gly-brand">
        <img fetchpriority="high" loading="eager" src="{{ 'images/teal_logo_trim.png'|asset }}" alt="{{ store.name }}">
        {% if is_page('index') %}
          <h1 class="sr-only">{{ store.name }}</h1>
        {% else %}
          <span class="sr-only">{{ store.name }}</span>
        {% endif %}
      </a>

      {# desktop menu — store header menu (dashboard-managed) with fallback #}
      <div class="gly-menu">
        {% for item in gly_nav %}
          <a href="{{ item.url }}"{{ loop.first ? ' class="has"' : '' }}>{{ item.title }}</a>
        {% endfor %}
      </div>
    </div>

    {# action icons — pushed to the inline-end (left in RTL) #}
    <div class="gly-icons">
      <button type="button" class="gly-ibtn" aria-label="{{ trans('blocks.gly.nav.search') }}"
        onclick="(function(){var s=document.querySelector('salla-search');if(s&&s.open){s.open()}else if(window.salla&&salla.event){salla.event.dispatch('search::open')}})()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>

      {# account — Salla user menu (handles login / profile) #}
      <salla-user-menu avatar-only show-trigger show-header></salla-user-menu>

      {# cart — Salla cart summary (live count, opens real cart) #}
      <salla-cart-summary>
        <i slot="icon" class="sicon-shopping-bag"></i>
      </salla-cart-summary>

      <button type="button" class="gly-ibtn gly-burger" id="gly-burger" aria-label="{{ trans('blocks.gly.nav.menu') }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>
</header>

{# mobile menu — partial side drawer with backdrop #}
<div class="gly-mscrim" id="gly-mscrim"></div>
<div class="gly-mmenu" id="gly-mmenu">
  <button type="button" class="gly-mclose" id="gly-mclose" aria-label="{{ trans('blocks.gly.nav.close') }}">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg>
  </button>
  {# mobile order: Home · Latest products · Sections (expandable) · Custom · rest #}
  <a href="{{ store.url }}">{{ trans('blocks.gly.nav.home') }}</a>

  {% if theme.settings.get('gly_show_latest', true) %}
    <a href="{{ theme.settings.get('gly_latest_url') ?: (gly_home ~ '/#gly-latest') }}">{{ trans('blocks.gly.nav.latest') }}</a>
  {% endif %}

  {% if theme.settings.get('gly_show_categories', true) %}
    <div class="gly-msub">
      <button type="button" class="gly-msub-toggle" aria-expanded="false">
        {{ trans('blocks.gly.nav.sections') }}
        <svg class="gly-msub-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="gly-msub-panel">
        {% include 'components.home.gly-cat-links' %}
      </div>
    </div>
  {% endif %}

  {% if theme.settings.get('gly_show_custom', true) %}<a href="{{ gly_home }}/#gly-custom">{{ trans('blocks.gly.nav.custom') }}</a>{% endif %}
  {% if theme.settings.get('gly_show_finder', true) %}<a href="{{ gly_home }}/#gly-finder">{{ trans('blocks.gly.nav.finder') }}</a>{% endif %}
  {% if theme.settings.get('gly_show_how', true) %}<a href="{{ gly_home }}/#gly-how">{{ trans('blocks.gly.nav.how') }}</a>{% endif %}
  {% if theme.settings.get('gly_show_testimonials', true) %}<a href="{{ gly_home }}/#gly-testi">{{ trans('blocks.gly.nav.testimonials') }}</a>{% endif %}
</div>
