{#
  Giftology — Footer  (§5.9)
  Brand (logo/name/description) from Salla store data. One link column = the
  store sections (الأقسام), links from the `gly_cat_*` category pickers
  resolved to real category-page URLs (same as the home circles / finder,
  via the gly-cat-url partial).
  Contact column = email / Instagram / WhatsApp (merchant-editable settings).
  Payment badges are design constants. Dark watermark = --gly-darkpat.
#}
{% set gly_home = store.url %}
{% set gly_wa_number = theme.settings.get('gly_whatsapp') ?: '966500000000' %}
{% set gly_wa_general = 'https://wa.me/' ~ gly_wa_number ~ '?text=' ~ trans('blocks.gly.wa.general_msg')|url_encode %}
{% set gly_email = theme.settings.get('gly_email') ?: store.contacts.email %}
{% set gly_instagram = store.social.instagram ?: theme.settings.get('gly_instagram') %}

{% set u_newborn %}{% include 'components.home.gly-cat-url' with {value: theme.settings.get('gly_cat_newborn'), fallback: store.url} only %}{% endset %}
{% set u_occasion %}{% include 'components.home.gly-cat-url' with {value: theme.settings.get('gly_cat_occasion'), fallback: store.url} only %}{% endset %}
{% set u_kids %}{% include 'components.home.gly-cat-url' with {value: theme.settings.get('gly_cat_kids'), fallback: store.url} only %}{% endset %}
{% set u_men %}{% include 'components.home.gly-cat-url' with {value: theme.settings.get('gly_cat_men'), fallback: store.url} only %}{% endset %}
{% set u_favors %}{% include 'components.home.gly-cat-url' with {value: theme.settings.get('gly_cat_favors'), fallback: store.url} only %}{% endset %}
{% set u_cards %}{% include 'components.home.gly-cat-url' with {value: theme.settings.get('gly_cat_cards'), fallback: store.url} only %}{% endset %}

{% set gly_cats = [
  { url: u_newborn,  label: trans('blocks.gly.cats.newborn') },
  { url: u_occasion, label: trans('blocks.gly.cats.occasion') },
  { url: u_kids,     label: trans('blocks.gly.cats.kids') },
  { url: u_men,      label: trans('blocks.gly.cats.men') },
  { url: u_favors,   label: trans('blocks.gly.cats.favors') },
  { url: u_cards,    label: trans('blocks.gly.cats.cards') }
] %}

<footer class="gly-footer">
  <div class="gly-footer__deco" aria-hidden="true"></div>
  <div class="gly-wrap">
    <div class="gly-fgrid">

      {# brand #}
      <div class="gly-fbrand">
        <img src="{{ 'images/white_logo_trim.png'|asset }}" alt="{{ store.name }}">
        <p>{{ store.description ?: trans('blocks.gly.footer.about') }}</p>
      </div>

      {# sections — links from settings #}
      <div>
        <h5>{{ trans('blocks.gly.footer.categories') }}</h5>
        <ul>
          {% for cat in gly_cats %}
            <li><a href="{{ cat.url ?: store.url }}">{{ cat.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      {# contact methods — email / Instagram / WhatsApp #}
      <div>
        <h5>{{ trans('blocks.gly.footer.contact') }}</h5>
        <ul class="gly-fcontact">
          {% if gly_email %}
            <li>
              <a href="mailto:{{ gly_email }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                <span>{{ gly_email }}</span>
              </a>
            </li>
          {% endif %}
          {% if gly_instagram %}
            <li>
              <a href="{{ gly_instagram }}" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                <span>{{ trans('blocks.gly.footer.instagram') }}</span>
              </a>
            </li>
          {% endif %}
          <li>
            <a href="{{ gly_wa_general }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5 13.6c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-3-.8-2.5-1.1-4-3.7-4.2-3.9-.1-.2-1-1.3-1-2.5s.6-1.7.8-2c.2-.2.5-.3.6-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.2.1.4 0 .5l-.4.5c-.1.2-.3.3-.1.6.1.3.7 1.1 1.4 1.7.9.8 1.6 1 1.9 1.2.2.1.4 0 .5-.1l.6-.7c.2-.2.3-.2.6-.1l1.6.8c.2.1.4.2.5.3.1.3.1.7-.1 1.2Z"/></svg>
              <span>{{ trans('blocks.gly.footer.whatsapp') }}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="gly-fbottom">
      <span>© {{ "now"|date("Y") }} {{ store.name }} · {{ trans('blocks.gly.footer.rights') }}</span>
      <div class="gly-pays">
        <span>مدى</span><span>Apple&nbsp;Pay</span><span>VISA</span><span>tabby</span><span>STC&nbsp;Pay</span>
      </div>
    </div>
  </div>
</footer>
