{#
  Giftology — Footer  (§5.9)
  Brand logo from store; about text from gly_footer_about (falls back to store
  description / locale). Sections column = the same category tiles as the home
  circles (gly-cat-links partial). Social row + contact +
  payment badges are all merchant-configurable via theme settings.
  Watermark = --gly-pat.
#}
{% set gly_home = store.url %}
{% set gly_wa_number = theme.settings.get('gly_whatsapp') ?: '966500000000' %}
{% set gly_wa_general = 'https://wa.me/' ~ gly_wa_number ~ '?text=' ~ trans('blocks.gly.wa.general_msg')|url_encode %}
{% set gly_email = theme.settings.get('gly_email') ?: store.contacts.email %}
{% set gly_instagram = store.social.instagram ?: theme.settings.get('gly_instagram') %}
{% set gly_tiktok = theme.settings.get('gly_tiktok') %}
{% set gly_x = theme.settings.get('gly_x') %}
{% set gly_snapchat = theme.settings.get('gly_snapchat') %}
{% set gly_facebook = theme.settings.get('gly_facebook') %}
{% set gly_about = theme.settings.get('gly_footer_about') ?: (store.description ?: trans('blocks.gly.footer.about')) %}

{# payment badges — only the ones toggled on #}
{% set gly_pays = [] %}
{% if theme.settings.get('gly_pay_mada', true) %}{% set gly_pays = gly_pays|merge(['مدى']) %}{% endif %}
{% if theme.settings.get('gly_pay_applepay', true) %}{% set gly_pays = gly_pays|merge(['Apple Pay']) %}{% endif %}
{% if theme.settings.get('gly_pay_visa', true) %}{% set gly_pays = gly_pays|merge(['VISA']) %}{% endif %}
{% if theme.settings.get('gly_pay_mastercard', true) %}{% set gly_pays = gly_pays|merge(['Mastercard']) %}{% endif %}
{% if theme.settings.get('gly_pay_tabby', true) %}{% set gly_pays = gly_pays|merge(['tabby']) %}{% endif %}
{% if theme.settings.get('gly_pay_tamara', false) %}{% set gly_pays = gly_pays|merge(['تمارا']) %}{% endif %}
{% if theme.settings.get('gly_pay_stcpay', true) %}{% set gly_pays = gly_pays|merge(['STC Pay']) %}{% endif %}

<footer class="gly-footer">
  <div class="gly-footer__deco" aria-hidden="true"></div>
  <div class="gly-wrap">
    <div class="gly-fgrid">

      {# brand + socials #}
      <div class="gly-fbrand">
        <img src="{{ 'images/white_logo_trim.png'|asset }}" alt="{{ store.name }}">
        <p>{{ gly_about }}</p>
        <div class="gly-social">
          {% if gly_instagram %}<a href="{{ gly_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>{% endif %}
          {% if gly_tiktok %}<a href="{{ gly_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2.3 1.7 3.9 4 4.2v3c-1.5 0-2.9-.4-4-1.1V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V3h3Z"/></svg></a>{% endif %}
          {% if gly_x %}<a href="{{ gly_x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 3h3l-7 8 8.2 10h-6.4l-5-6.1L7 21H4l7.5-8.6L3.5 3h6.5l4.5 5.6L17.5 3Zm-1.1 16h1.7L8.2 4.8H6.4L16.4 19Z"/></svg></a>{% endif %}
          {% if gly_snapchat %}<a href="{{ gly_snapchat }}" target="_blank" rel="noopener" aria-label="Snapchat"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c2.6 0 4.3 2 4.4 4.6 0 .6 0 1.2-.1 1.7.3.2.7.2 1 .1.6-.2 1.3.6.8 1.3-.4.5-1.1.7-1.6.9-.3.6.6 2.4 2.6 3 .5.2.4.9-.1 1.1-.6.2-1.3.2-1.6.7-.2.5.1 1-.6 1.1-.6.1-1.2-.2-1.9 0-.6.2-1.1 1-2.4 1s-1.7-.8-2.4-1c-.7-.2-1.3.1-1.9 0-.7-.1-.4-.6-.6-1.1-.3-.5-1-.5-1.6-.7-.5-.2-.6-.9-.1-1.1 2-.6 2.9-2.4 2.6-3-.5-.2-1.2-.4-1.6-.9-.5-.7.2-1.5.8-1.3.3.1.7.1 1-.1-.1-.5-.1-1.1-.1-1.7C7.7 4 9.4 2 12 2Z"/></svg></a>{% endif %}
          {% if gly_facebook %}<a href="{{ gly_facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8.5V11h2.5l-.4 2.6H14V21h-2.7v-7.4H9V11h2.3V8.1c0-2.3 1.4-3.6 3.5-3.6 1 0 2 .2 2 .2v2.2h-1.1c-1.1 0-1.7.5-1.7 1.6Z"/></svg></a>{% endif %}
          <a href="{{ gly_wa_general }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5 13.6c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-3-.8-2.5-1.1-4-3.7-4.2-3.9-.1-.2-1-1.3-1-2.5s.6-1.7.8-2c.2-.2.5-.3.6-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.2.1.4 0 .5l-.4.5c-.1.2-.3.3-.1.6.1.3.7 1.1 1.4 1.7.9.8 1.6 1 1.9 1.2.2.1.4 0 .5-.1l.6-.7c.2-.2.3-.2.6-.1l1.6.8c.2.1.4.2.5.3.1.3.1.7-.1 1.2Z"/></svg></a>
        </div>
      </div>

      {# sections — same category tiles as the home circles #}
      <div>
        <h5>{{ trans('blocks.gly.footer.categories') }}</h5>
        <nav class="gly-flinks">{% include 'components.home.gly-cat-links' %}</nav>
      </div>

      {# contact methods — email / WhatsApp #}
      <div>
        <h5>{{ trans('blocks.gly.footer.contact') }}</h5>
        <ul class="gly-fcontact">
          {% if gly_email %}
            <li>
              <a href="mailto:{{ gly_email }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                <span>{{ gly_email }}</span>
              </a>
            </li>
          {% endif %}
          <li>
            <a href="{{ gly_wa_general }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5 13.6c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-3-.8-2.5-1.1-4-3.7-4.2-3.9-.1-.2-1-1.3-1-2.5s.6-1.7.8-2c.2-.2.5-.3.6-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.2.1.4 0 .5l-.4.5c-.1.2-.3.3-.1.6.1.3.7 1.1 1.4 1.7.9.8 1.6 1 1.9 1.2.2.1.4 0 .5-.1l.6-.7c.2-.2.3-.2.6-.1l1.6.8c.2.1.4.2.5.3.1.3.1.7-.1 1.2Z"/></svg>
              <span>{{ trans('blocks.gly.footer.whatsapp') }}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="gly-fbottom">
      <span>© {{ "now"|date("Y") }} {{ store.name }} · {{ trans('blocks.gly.footer.rights') }}</span>
      {% if gly_pays|length %}
        <div class="gly-pays">
          {% for p in gly_pays %}<span>{{ p }}</span>{% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>
