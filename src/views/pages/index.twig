{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "cat.show"                                                      |

  Giftology homepage — bespoke curated sections, each behind a merchant toggle:
  hero → latest products → categories → custom → gift finder → how-it-works →
  testimonials. The generic {% component home %} builder region was removed
  because the demo store seeded it with a products block that duplicated our
  Latest products section; the home is now deterministic.
#}
{% extends "layouts.master" %}
{% block content %}
    {% if theme.settings.get('gly_show_hero', true) %}
        {% include 'components.home.gly-hero' %}
    {% endif %}

    {% if theme.settings.get('gly_show_latest', true) %}
        {% include 'components.home.gly-latest-products' %}
    {% endif %}

    {% if theme.settings.get('gly_show_categories', true) %}
        {% include 'components.home.gly-categories' %}
    {% endif %}

    {% if theme.settings.get('gly_show_custom', true) %}
        {% include 'components.home.gly-custom-gift' %}
    {% endif %}

    {% if theme.settings.get('gly_show_finder', true) %}
        {% include 'components.home.gly-gift-finder' %}
    {% endif %}

    {% if theme.settings.get('gly_show_how', true) %}
        {% include 'components.home.gly-how-it-works' %}
    {% endif %}

    {% if theme.settings.get('gly_show_testimonials', true) %}
        {% include 'components.home.gly-testimonials' %}
    {% endif %}
{% endblock %}
{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}
